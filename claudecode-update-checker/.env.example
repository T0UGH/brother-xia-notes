# Claude Code 更新检查器 - 环境变量配置

# 飞书 Webhook URL（必填，用于接收更新通知）
# 获取方式：
# 1. 打开飞书，进入一个群聊
# 2. 点击群设置 → 群机器人
# 3. 添加机器人 → 自定义机器人
# 4. 复制 Webhook 地址并粘贴到下面
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxx

# 代理设置（如果在内网或需要代理）
HTTP_PROXY=http://127.0.0.1:1087
HTTPS_PROXY=http://127.0.0.1:1087

# 检查间隔（小时，默认 24 小时）
CHECK_INTERVAL_HOURS=24

# 通知时间（24小时制，默认 9:00）
NOTIFY_HOUR=9
NOTIFY_MINUTE=0
